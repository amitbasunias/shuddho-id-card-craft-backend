# Copy to .env and adjust. All are optional for local development.

# Generate a fresh one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# Turn DEBUG off in production.
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the admin.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Display currency for plans/invoices.
SAAS_DEFAULT_CURRENCY=BDT

# How many days before period end to flag an account as "due soon".
SAAS_DUE_SOON_DAYS=7

# Admin branding.
SAAS_SITE_NAME=ID Craft SaaS

# Optional: point SQLite somewhere else (e.g. outside a network share that
# doesn't support SQLite locking). Leave unset to use db.sqlite3 in the project.
# SAAS_DB_PATH=C:\path\to\db.sqlite3
